rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.get('email_verified', false) == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Users ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid == userId
          && data.email is string && data.email.size() <= 100
          && data.displayName is string && data.displayName.size() <= 100
          && data.totalMinutes is number
          && (data.settings == null || (
              data.settings.workDuration is number &&
              data.settings.shortBreakDuration is number &&
              data.settings.longBreakDuration is number &&
              data.settings.autoStartNextMode is bool
          ));
      }

      allow get: if isOwner(userId);
      allow create: if isOwner(userId) 
        && isValidUser(incoming())
        && incoming().createdAt == request.time;
      allow update: if isOwner(userId)
        && isValidUser(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['totalMinutes', 'displayName', 'settings']);
    }

    // --- Tasks ---
    match /tasks/{taskId} {
      function isValidTask(data) {
        return data.userId == request.auth.uid
          && data.title is string && data.title.size() <= 200
          && data.category is string && data.category.size() <= 100
          && data.totalSeconds is number
          && data.completed is bool
          && data.createdAt is timestamp
          && (data.priority == null || data.priority in ['low', 'medium', 'high'])
          && (data.lastActiveAt == null || data.lastActiveAt is timestamp);
      }

      // Secure list query
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isVerified() && isValidTask(incoming()) 
        && incoming().createdAt == request.time
        && incoming().lastActiveAt == request.time
        && incoming().priority in ['low', 'medium', 'high'];
      
      allow update: if isVerified() && existing().userId == request.auth.uid 
        && isValidTask(incoming())
        && (
            // Action: Toggle Complete
            (incoming().diff(existing()).affectedKeys().hasOnly(['completed'])) ||
            // Action: Update Progress
            (incoming().diff(existing()).affectedKeys().hasOnly(['totalSeconds', 'lastActiveAt'])) ||
            // Action: Edit Task
            (incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'priority']))
        );
      allow delete: if isVerified() && existing().userId == request.auth.uid;
    }

    // --- Sessions ---
    match /sessions/{sessionId} {
      function isValidSession(data) {
        return data.userId == request.auth.uid
          && data.taskId is string
          && data.durationSeconds is number
          && data.type in ['work', 'short_break', 'long_break']
          && data.createdAt is timestamp;
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isVerified() && isValidSession(incoming())
        && incoming().createdAt == request.time;
    }
  }
}
